# Dim Kava Internal Learning Portal — Environment Variables
# Copy to .env and fill in values. Never commit .env.

# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DATABASE_URL=postgres://user:password@localhost:5432/dimkava_db

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# Default users (created on first setup)
DEFAULT_ADMIN_EMAIL=admin@dimkava.ge
DEFAULT_ADMIN_PASSWORD=changeme_admin

DEFAULT_HR_EMAIL=hr@dimkava.ge
DEFAULT_HR_PASSWORD=changeme_hr

DEFAULT_EMPLOYEE_EMAIL=employee@dimkava.ge
DEFAULT_EMPLOYEE_PASSWORD=changeme_employee

# Candidate (pre-hire) user
DEFAULT_CANDIDATE_EMAIL=candidate@dimkava.ge
DEFAULT_CANDIDATE_PASSWORD=changeme_candidate
DEFAULT_CANDIDATE_PHONE=+995500000000

# DeepL API (optional — YAML/DB auto-translation for ka/ru)
# DEEPL_AUTH_KEY=
# DEEPL_API_URL=https://api-free.deepl.com/v2/translate

# Railway / Docker deploy (production)
# AUTO_LOAD_HR_CONTENT=1
# Load courses, onboarding, KB, news, departments from YAML on each container start (keeps DB in sync with git translations).

# Media (local for dev)
MEDIA_ROOT=media/

# Email (console for dev; set SMTP in production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Dim Kava <noreply@dimkava.ge>
